<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sixgroup.refit.common.base</groupId>
        <artifactId>rft-common-base-parent-featured</artifactId>
        <version>1.3.0</version>
    </parent>

    <groupId>com.sixgroup.refit.observability</groupId>
    <artifactId>rft-observability-item-batch</artifactId>
    <version>${revision}${sha1}${changelist}</version>

    <properties>
        <revision>0.2.5</revision>
        <sha1/>
        <changelist>-SNAPSHOT</changelist>

        <!-- Contract for controller (openapi) -->
        <rft-commons-ctm-openapi.version>1.0.0</rft-commons-ctm-openapi.version>

        <!-- Spotless -->
        <spotless-maven-plugin.version>2.34.0</spotless-maven-plugin.version>
        <spotless-file-name>refit-formatter.xml</spotless-file-name>
    </properties>

    <dependencies>

        <!-- Compilation starters -->
        <dependency>
            <groupId>com.sixgroup.refit.common.base</groupId>
            <artifactId>rft-common-base-starter-server-backend</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sixgroup.refit.common.base</groupId>
            <artifactId>rft-common-base-starter-feature-impala</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test starters -->
        <dependency>
            <groupId>com.sixgroup.refit.common.base</groupId>
            <artifactId>rft-common-base-test-starter-feature-cucumber</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.sixgroup.refit.common.base</groupId>
            <artifactId>rft-common-base-test-starter-feature-impala</artifactId>
            <scope>test</scope>
        </dependency>

        <!--OpenApi contract -->
        <dependency>
            <groupId>com.sixgroup.refit.external</groupId>
            <artifactId>rft-commons-ctm-openapi</artifactId>
            <version>${rft-commons-ctm-openapi.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
                <configuration>
                    <formats>
                        <format>
                            <includes>
                                <include>*.md</include>
                                <include>*.json</include>
                                <include>.gitignore</include>
                            </includes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                            <indent>
                                <spaces>true</spaces>
                                <spacesPerTab>4</spacesPerTab>
                            </indent>
                        </format>
                    </formats>
                    <java>
                        <eclipse>
                            <version>4.21.0</version>
                            <file>${project.basedir}/${spotless-file-name}</file>
                        </eclipse>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports/>
                        <toggleOffOn/>
                        <importOrder>
                            <order>java,javax,org.springframework,org,com,com.sixgroup,</order>
                        </importOrder>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
