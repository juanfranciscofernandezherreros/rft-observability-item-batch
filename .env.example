# Copy to .env and adjust as needed. Never commit the real .env file.

APP_PORT=9001
SPRING_PROFILES_ACTIVE=docker

# Primary datasource (JdbcTemplate, Spring Batch job repository).
# Defaults to an ephemeral in-memory H2 instance; point it at a real
# database for anything beyond local/demo use.
SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Kudu/Impala datasource used by DatasourceKuduConfig.
# Defaults to a second in-memory H2 instance for local/demo use; point it
# at a real Kudu/Impala JDBC URL for an actual environment.
SPRING_DATASOURCE_KUDUDB_JDBC_URL=jdbc:h2:mem:kududb;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_KUDUDB_USERNAME=sa
SPRING_DATASOURCE_KUDUDB_PASSWORD=

# T32A job parameters.
APP_JOBS_T32A_END_PERIOD=2026-03-31
APP_JOBS_T32A_REPORTING_DATE=2026-04-30
